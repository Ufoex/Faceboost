<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+ (API 31+).
   Only the settings DataStore is copied. The WebView's profile (app_webview/), which holds
   the Facebook session cookies, stays on the device, so a restore or a new phone starts
   logged out instead of carrying the session over. With an <include>, anything not listed is
   excluded. See backup_rules.xml for API 30 and lower.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
